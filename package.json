{
  "name": "vue3-prlx",
  "version": "0.2.0",
  "type": "module",
  "main": "./dist/VuePrlx.umd.cjs",
  "module": "./dist/VuePrlx.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/VuePrlx.js",
      "require": "./dist/VuePrlx.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "vue",
    "vue3",
    "vue-plugin",
    "directive",
    "parallax",
    "scroll"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc",
    "preview": "vite preview",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-vuetify": "^2.1.3",
    "vue": "^3.5.44"
  },
  "description": "Vue 3 plugin and directive for scroll parallax effects. Vue 3 port of vue-prlx.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/A-Behairi/vue3-prlx.git"
  },
